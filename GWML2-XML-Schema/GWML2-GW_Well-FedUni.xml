<?xml version="1.0" encoding="UTF-8"?>
<gml:FeatureCollection gml:id="feduni.example.well1" xmlns:gww="http://www.opengis.net/gwml-well/2.0" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:sam="http://www.opengis.net/sampling/2.0" xmlns:sams="http://www.opengis.net/samplingSpatial/2.0" xmlns:gu="http://xmlns.geosciml.org/GeologicUnit/3.2" xmlns:gsmlga="http://xmlns.geosciml.org/GeologicAge/3.2" xmlns:gwml2="http://www.opengis.net/gwml-nucleus/2.0" xmlns:gwml2f="http://www.opengis.net/gwml-flow/2.0" xmlns:gwml2wc="http://www.opengis.net/gwml-wellconstruction/2.0" xmlns:gwml2c="http://www.opengis.net/gwml-constituent/2.0" xmlns:gsmlem="http://xmlns.geosciml.org/EarthMaterial/3.2" xmlns:gsml="http://xmlns.geosciml.org/GeoSciML-Core/3.2" xmlns:gsmlpp="http://xmlns.geosciml.org/PhysicalProperties/3.2" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:swe="http://www.opengis.net/swe/2.0" xmlns:gmd="http://www.isotc211.org/2005/gmd" xmlns:gco="http://www.isotc211.org/2005/gco" xmlns:cv="http://www.opengis.net/cv/0.2/gml32" xmlns:om="http://www.opengis.net/om/2.0" xmlns:spec="http://www.opengis.net/samplingSpecimen/2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.opengis.net/gwml/2.0 http://ngwd-bdnes.cits.nrcan.gc.ca/service/gwml/schemas/gwml2.xsd http://www.opengis.net/samplingSpecimen/2.0 http://schemas.opengis.net/samplingSpecimen/2.0/specimen.xsd">
	<!-- Although all the GWML2 schema may not be required, this instance imports all GWML2 packages via gwml2.xsd for consistence between instance examples  -->
	<!-- ######################### -->
	<!-- Mapping of Federation University (FedUni) Groundwater database tables and records to the proposed GroundWaterML2 OGC standard release candidate  -->
	<!-- File created by Bruce Simons, CSIRO, August 2014 -->
	<!-- ######################### -->
	<!-- This file is an example instance of a GWML2 GW_well -->
	<!-- Although this instance is a gml:FeatureCollection with one or more gml:featureMembers, a valid alternative is as a single gww:GW_Well -->
	<!-- Other related GWML2 features are referred to "byReference" using xlink:href. In most cases these could be included "inLine" (i.e. within this instance). A separate instance for each feature is provided for ease of mapping. The final aggregation of inLine vs. byReference features will be determined by the use case requirements -->
	<!-- Where features are aggregated into single feature services the xlink:href references to URIs need to be replaced with internal # references to gml:id -->
	<!-- ######################### -->
	<!-- FedUni - Mapping patterns -->
	<!-- Comments beginning 'FedUni -' are instructions for mappings between FedUni data and GWML2 -->
	<!-- ???? Comments beginning ???? require further checking -->
	<!-- FedUni table record pairs are referred to by the pattern [table.record] -->
	<!-- The mapping pattern is [schema/property] = [table.record] -->
	<!-- ######################### -->
	<!-- FedUni - Feature IDs and identifiers -->
	<!-- Feature IDs (gml:id) are document specific unique identifiers based on FedUni table keys and the feature type -->
	<!-- To create the id, replace [table.record_id] with values from the appropriate table -->
	<!-- Feature identities (gml:identifier) use the URI for the feature. This is in the format "[domain name]/[category]/[type]/[gml:id]" -->
	<!-- Domain Name - The temporary domain name "http://www.groundwater-victoria.com.au" has been used for the feature identifiers and vocabulary term references. An appropriate persistent and organisation independent domain will need to be established.
A redirect service, such as the SISS PID service, is required to resolve these URIs -->
	<!-- Category - where the object is a GML Feature use "feature". Where the object is a vocabulary concept use "def". -->
	<!-- Type - where the Category is a feature, the type of feature, where Category is "def' the type of term (e.g. from "http://environment.data.gov.au/def/" it is "object", "unit", "property") -->
	<!-- ######################### -->
	<!-- FedUni Mapping -->
	<!-- First test is to see if the FedUni Bore is Spring -->
	<!-- If [bore.boretype] = "Spring" (SPR) then the feature is a GW_Spring -->
	<!-- Second test is to see if the FedUni Bore is a Monitoring Point -->
	<!-- If [bore:monitoring_Status] ="Y" then establish GWML2:GW_MonitoringSite feature with gwMonitoringHost xlink:href="http://groundwater.feduni.edu/borehole/feduni/[bore.bore_id] -->
	<!-- gml:featureMember is a GW_Well -->
	<gml:featureMember>
		<!-- FedUni - gww:GW_Well gml:id= "feduni.borehole.[bore.bore_ID]" -->
		<gww:GW_Well gml:id="feduni.borehole.51409">
			
			<!-- FedUni - gww:GW_Well/gml:description = [bore.site_desc]  -->
			<gml:description>SOBN bore</gml:description>
			<!-- FedUni - <gml:identifier codeSpace="http://www.ietf.org/rfc/rfc2616">http://groundwater.victoria.com.au/feature/water-well/feduni.borehole.[bore.bore_id]"</gml:identifier> -->
			<gml:identifier codeSpace="http://www.ietf.org/rfc/rfc2616">http://groundwater.victoria.com.au/feature/water-well/feduni.borehole.51409</gml:identifier>
			<!-- FedUni - Other gml:names are to come from [bore.oldid], [bore.local_bore_name], [bore.bore_code] -->
			<!-- gml:name codeSpace should identify a dictionary, thesaurus or authority for the term, such as the organisation who assigned the value, or the dictionary from which it is taken. -->
			<gml:name codeSpace="http://www.groundwater-victoria.com.au/def/feduni/waterwell/oldboreid">093</gml:name>
			<gml:name codeSpace="http://www.groundwater-victoria.com.au/def/feduni/waterwell/borecode">119330</gml:name>
			<gml:name codeSpace="http://www.groundwater-victoria.com.au/def/feduni/waterwell/localborename">Ballarat 9037</gml:name>
			<!-- gml:boundedBy envelope to be generated by middleware on the fly -->
			<gml:boundedBy>
				<gml:Envelope srsName="EPSG:4939">
					<gml:pos srsDimension="2">139 -32</gml:pos>
					<gml:pos srsDimension="2">143 -37</gml:pos>
				</gml:Envelope>
			</gml:boundedBy>
			<!-- sam:sampledFeature is 1..*. It allows specifying the GW_HydrogeoUnits (GeologicUnits) intersected in the Well. -->
			<!-- FedUni - these could be GeologicUnits (type = "stratigraphic unit") from [stratigraphy], or GW_Aquifer (type = "hydrogeological unit" from [aquifer-property] -->
			<!-- FedUni - For stratigraphic sampled features:
sam:sampledFeature xlink:href="http://www.groundwater-victoria.com.au/feature/stratigraphicunit/[stratigraphy.bore_id_fk].[stratigraphy.strat_code]" xlink:title="[aquifer-property.aq_name] -->
			<sam:sampledFeature xlink:href="http://www.groundwater-victoria.com.au/feature/stratigraphicunit/feduni/51409.3770" xlink:title="Newer Volcanics"/>
			<!-- FedUni - For aquifer sampled features:
sam:sampledFeature xlink:href="http://www.groundwater-victoria.com.au/feature/aquifer/[aquifer-property.bore_id_fk].[aquifer-property.aquifer-property_id]" xlink:title="[aquifer-property.aq_name] -->
			<sam:sampledFeature xlink:href="http://www.groundwater-victoria.com.au/feature/aquifer/feduni/51409.1947" xlink:title="Newer Volcanics"/>
			<!-- FedUni - If no stratigraphy or aquifer GW_HydrogeoUnits then use the unknown default: 
sam:sampledFeature xlink:href="http://www.opengis.net/def/nil/OGC/0/unknown" xlink:title="unknown" -->
			<sam:sampledFeature xlink:href="http://www.opengis.net/def/nil/OGC/0/unknown" xlink:title="unknown"/>
			<!-- sam:relatedObservation allows linking or describing extra observations down the well -->
<!-- FedUni - if [chemistry_code.chemistry_category_id] = "6", "7" or "8" they will be delivered as relatedObservations instead of relatedSamplingFeatures. -->
<!-- sam:relatedObservation xlink:href="http://groundwater.victoria.com.au/feature/observation/feduni.borehole.[bore.bore_ID].[hydrochemistry.hydrochemistry_id].[sample_chemistry.sample_chemistry_id]" --> 
			<!-- FedUni - sam:relatedObservation example for pH -->
			<sam:relatedObservation xlink:href="http://groundwater.victoria.com.au/feature/observation/feduni.borehole.51409.44574.32328"/>
			<!-- FedUni - OM_Observation example for 18Oxygen  -->
			<sam:relatedObservation xlink:href="http://groundwater.victoria.com.au/feature/observation/feduni.borehole.51409.44574.32317"/>
			<!-- FedUni - [swl] table measurements to be delivered as WaterML2 TimeSeries observations, sam:relatedObservation will point to these using xlink:href  -->
			<!-- ???? FedUni - example xlink:href to timeseries feature required   -->
			<sam:relatedObservation xlink:href="http://groundwater.victoria.com.au/sos/feduni/borehole/swl/26101994120000-14121994120000"/>
			<!-- sam:relatedSamplingFeature is for describing related specimens (e.g. water samples) from the well -->
			<!--	FedUni - if [chemistry_code.chemistry_category_id] = "1", "2", "3", "4", "5" or "9", or "6" and Name = "Dissolved Oxygen" (i.e. all chemical or biological constituent observations) then a sam:relatedSamplingFeature (i.e. a specimen) has been taken, and its constituents determined. The specimen has sampled the GW_FluidBody. -->
						
						<!-- FedUni - spec:SF_Specimen gml:id = feduni.borehole.specimen.[bore.bore_ID].[hydrochemistry.hydrochemistry_id] -->
<sam:relatedSamplingFeature>
				<sam:SamplingFeatureComplex>
				<!-- FedUni - sam:role xlink:href="http://www.opengis.net/def/gwml/role/waterSample" xlink:title="Water sample" -->
					<sam:role xlink:href="http://www.opengis.net/def/gwml/role/waterSample" xlink:title="Water sample"/>
<!-- sam:relatedSamplingFeature identifies the specimens taken from the GW_Well -->					
<!-- FedUni - sam:relatedSamplingFeature xlink:href="http://groundwater.victoria.com.au/feature/specimen/feduni.borehole.specimen.[bore.bore_ID].[hydrochemistry.hydrochemistry_id] " -->
					<sam:relatedSamplingFeature xlink:href="http://groundwater.victoria.com.au/feature/specimen/feduni.borehole.specimen.51409.44574"/>
						
				</sam:SamplingFeatureComplex>
			</sam:relatedSamplingFeature>
			<!--  [bore.rlns] is the reference point for all the FedUni elevation -->
			<sams:shape>
			<!-- gml:Curve gml:id="feduni.borehole.[bore.bore_ID].shape" -->
				<gml:Curve gml:id="feduni.borehole.51409.shape" srsDimension="3" srsName="http://www.opengis.net/def/crs/EPSG/0/4283">
					<gml:segments>
						<!-- FedUni - Assume well is vertical and [bore.constructed_depth] is depth of well from [bore.rlns] then:
<gml:posList> = [bore:longitude_gda94], [bore:latitude.gda94], [bore.rlns] [bore.longitude_gda94], [bore.latitude:gda94], {[bore.rlns]-[bore.constructed_depth]} -->
						<!-- Check order is right for SRS -->
						<gml:LineStringSegment>
							<gml:posList>141.79256 -37.85769 523.27 141.79256 -37.85769 493.27</gml:posList>
						</gml:LineStringSegment>
					</gml:segments>
				</gml:Curve>
			</sams:shape>
			<!-- gwWellBody describes the fluid body (GW_FluidBody) within the Well -->
			<!-- FedUni - gww:gwWellBody xlink:href="http://groundwater.victoria.com.au/feature/fluid-body/feduni.borehole.fluid-body.[bore.bore_ID].[hydrochemistry.hydrochemistry_id]" -->
			<gww:gwWellBody xlink:href="http://groundwater.victoria.com.au/feature/fluid-body/feduni.borehole.fluid-body.51409.44574"/>
			
			<!-- GW_Well only allows [0..1] gww:gwWellConstructedDepth. FedUni records changing depth of well over time through [bore_condition]. Use initial constructed depth value from [bore.constructed_depth] -->
			<gww:gwWellConstructedDepth>
				<!-- om:OM_Observation gml:id= "feduni.borehole.[bore.bore_ID].constructed-depth" -->
				<om:OM_Observation gml:id="feduni.borehole.51409.constructed-depth">
					<!-- om:phenomenomTime is the time the observation of the depth of the well was made -->
					<!-- gml:TimeInstant is defined here but could be an xlink:href to a date specified elsewhere in the mapping -->
					<!-- FedUni - assume completed date [bore.datecomp] is the om:phenomenonTime -->
					<om:phenomenonTime>
						<gml:TimeInstant gml:id="feduni.borehole.51409.date">
							<gml:timePosition>1993-11-10+00:00</gml:timePosition>
						</gml:TimeInstant>
					</om:phenomenonTime>
					<!-- FedUni - reference {gww:gwWellConstructedDepth/om:phenomenonTime/gml:TimeInstant gml:id} for all initial GW_Well time properties -->
					<om:resultTime xlink:href="#feduni.borehole.51409.date"/>
					<!-- FedUni does not have the procedure used to measure the depth of the well -->
					<om:procedure xsi:nil="true" nilReason="missing"/>
					<!-- om:observedProperty is self-referential -->
					<!-- Used {namespace}/{property} -->
					<om:observedProperty xlink:href="http://www.opengis.net/gwml-well/2.0/gwWellConstructedDepth" xlink:title="gwWellConstructedDepth"/>
					<!-- FedUni - om:featureOfInterest is the GW_Well. Use xlink:href internal reference -->
					<om:featureOfInterest xlink:href="#feduni.borehole.51409"/>
					<om:result>
						<swe:Quantity>
						<!-- FedUni - <swe:uom xlink:href="http://qudt.org/vocab/unit#Meter" xlink:title="metre" code="m"/> -->
							<swe:uom xlink:href="http://qudt.org/vocab/unit#Meter" xlink:title="metre" code="m"/>
							<!-- FedUni gww:gwWellConstructedDepth swe:value= [bore.constructed_depth] -->
							<swe:value>30.00</swe:value>
						</swe:Quantity>
					</om:result>
				</om:OM_Observation>
			</gww:gwWellConstructedDepth>
			<!-- FedUni - gww:gwWellConstruction is a reference to gwml2wc:Borehole feature -->
			<!-- FedUni - gww:gwWellConstruction xlink:href="http://groundwater.victoria.com.au/feature/constituent/feduni.borehole.construction.[bore.bore_ID]" -->
			<gww:gwWellConstruction xlink:href="http://groundwater.victoria.com.au/feature/constituent/feduni.borehole.construction.51409"/>
			<!-- gww:gwWellContributionZone is the area surrounding a pumping well or other discharge site that encompasses all areas and features that supply groundwater to the well or discharge site. -->
			<!-- FedUni - gww:gwWellContributionZone is not known -->
			<gww:gwWellContributionZone/>
			<gww:gwWellLocation>
				<!-- gml:Point gml:id is the identifier for the GW_Well:gwWellLocation. If it is defined elsewhere use <gww:gwWellLocation xlink:href="#{gml:id}"/> -->
				<!-- For FedUni, if defined here use gml:id="[gww:GW_Well gml:id].location" and gml:pos = [bore.longitude_gda94], [bore.latitude_gda94] -->
				<gml:Point gml:id="feduni.borehole.51409.location" srsName="EPSG:4939">
					<gml:pos>141.79256 -37.85769</gml:pos>
				</gml:Point>
			</gww:gwWellLocation>
			<!-- FedUni - gww:gwWellPurpose xlink:title=[bore.boretype] -->
			<gww:gwWellPurpose xlink:title="Groundwater"/>
			<!-- FedUni - gww:gwWellPurpose (1) xlink:title=[bore.uses1] -->
			<gww:gwWellPurpose xlink:title="Observation"/>
			<!-- FedUni - gww:gwWellPurpose (2) xlink:title=[bore.uses2] if present -->
			<gww:gwWellPurpose xlink:title="Groundwater Investigation"/>
			<!-- FedUni - gww:gwWellPurpose (3) xlink:title=[bore.uses3] if present. If no uses1, uses2 or uses3 present use gww:gwWellPurpose xsi:nil="true" nilReason="unknown" -->
			<gww:gwWellPurpose xsi:nil="true" nilReason="unknown"/>
			<!-- GWML2 allows multiple gww:gwWellReferenceElevation. If multiples are provided which is the reference elevation for the "from - to" properties? -->
			<!-- FedUni - Multiple gww:gwWellReferenceElevation used to capture [bore.collar], [bore.casing_standpipe], [bore.headworks_height]. -->
			<gww:gwWellReferenceElevation>
				<gww:Elevation>
					<!-- FedUni: gww:elevation value from [bore:rlns] or [bore.digitisedelevation]  -->
					<gww:elevation srsName="http://www.opengis.net/def/crs/EPSG/0/5711" uomLabels="m AHD" srsDimension="1">523.27</gww:elevation>
					<!-- FedUni - does not have gww:elevationAccuracy -->
					<gww:elevationAccuracy/>
					<gww:elevationType xlink:title="Relative Level Natural Surface"/>
					<!-- FedUni - gww:elevationMeasurementMethod = [bore.elevation_method] -->
					<gww:elevationMeasurementMethod xsi:nil="true" nilReason="unknown"/>
				</gww:Elevation>
			</gww:gwWellReferenceElevation>
			<gww:gwWellReferenceElevation>
				<gww:Elevation>
					<!-- FedUni: gww:elevation value from [bore:casing_standpipe]  -->
					<!-- [bore:casing_standpipe] is height of casing above rlns. Therefore gww:elevation = {[bore:rlns]+[bore:casing_standpipe]} -->
					<gww:elevation srsName="http://www.opengis.net/def/crs/EPSG/0/5711" uomLabels="m AHD" srsDimension="1">523.77</gww:elevation>
					<!-- FedUni - does not have gww:elevationAccuracy for [bore.casing_standpipe] -->
					<gww:elevationAccuracy/>
					<gww:elevationType xlink:title="Casing Standpipe"/>
					<!-- FedUni - does not have gww:elevationMeasurementMethod for [bore.casing_standpipe] -->
					<gww:elevationMeasurementMethod xsi:nil="true" nilReason="unknown"/>
				</gww:Elevation>
			</gww:gwWellReferenceElevation>
			<gww:gwWellReferenceElevation>
				<gww:Elevation>
					<!-- FedUni: gww:elevation value from [bore:headworks_height]  -->
					<!-- [bore:casing_standpipe] is height of casing above rlns. Therefore gww:elevation = {[bore:rlns]+[bore:headworks_height]} -->
					<gww:elevation srsName="http://www.opengis.net/def/crs/EPSG/0/5711" uomLabels="m AHD" srsDimension="1">524.29</gww:elevation>
					<!-- FedUni - does not have gww:elevationAccuracy for [bore.headworks_height] -->
					<gww:elevationAccuracy/>
					<gww:elevationType xlink:title="Headworks Height"/>
					<!-- FedUni - does not have gww:elevationMeasurementMethod for [bore.headworks_height] -->
					<gww:elevationMeasurementMethod xsi:nil="true" nilReason="unknown"/>
				</gww:Elevation>
			</gww:gwWellReferenceElevation>
			<!-- FedUni - has an initial swl [bore.initial.swl] and then time series values for swl [swl.meas_swl]. Use [bore.initial.swl] for gww:gwWellStaticWaterDepth -->
			<!-- FedUni - gww:gwWellStaticWaterDepth OM_Observation could be inLine or ByReference. Example is byReference -->
			<gww:gwWellStaticWaterDepth xlink:href="http://groundwater.victoria.com.au/feature/observation/feduni.borehole.observation.51409.initial-swl"/>
			
			<!-- #### gwWellStatusType should allow nilReason -->
			<!-- FedUni - does not have gww:gwWellStatus -->
			<gww:gwWellStatus/>
			<!-- FedUni - does not specifically have gww:gwWellTotalLength. Suggest using [bore.constructed_depth], (note though [lithology.to_m] or [stratigraphy.to_m] may be deeper than [bore.constructed_depth]) -->
			<gww:gwWellTotalLength>
				<swe:Quantity>
					<swe:uom xlink:href="http://qudt.org/vocab/unit#Meter" xlink:title="metre" code="m"/>
					<swe:value>30</swe:value>
				</swe:Quantity>
			</gww:gwWellTotalLength>
			<!-- #### gwWellUnit specifies the GW_HydrogeoUnit. This duplicates the sampledFeature property. It also duplicates the GW_GeologyLog. Examples of all 3 are provided as xlink:hrefs but may not be required  -->
			<!-- FedUni - This can be an Aquifer, ContainingBed, Basin or AquiferSystem.  -->
			<!-- FedUni - If Hydrogeologic Unit identities are available then use "byReference" (xlink:href). If not describe hydrogeologic unit in-line -->
			<!-- FedUni - This example is from [stratigraphy] table -->
			<!-- FedUni - gww:gwWellUnit  xlink:href="http://groundwater.victoria.com.au/feature/stratigraphic-unit/[stratigraphy.stratigraphy_id]" xlink:title="[stratigraphy.formation_description]" xlink:role="stratigraphic unit"/> -->
			<gww:gwWellUnit xlink:href="http://groundwater.victoria.com.au/feature/stratigraphic-unit/3770" xlink:title="Newer Volcanics" xlink:role="stratigraphic unit"/>
			
			<!-- FedUni - this example is from [lithology] and assumes the gww:gwWellUnit is a lithologic unit of type GW_Aquifer. -->
<!-- FedUni -  xlink:href="http://groundwater.victoria.com.au/feature/lithologic-unit/[lithology.lithology_id] xlink:title="[lithology.lithology_description] xlink:role="lithology unit"  -->
			<gww:gwWellUnit xlink:href="http://groundwater.victoria.com.au/feature/lithologic-unit/242285" xlink:title="SANDSTONE, well cemented sands of granitic origin intermixed with granite clasts" xlink:role="lithology unit"/>
				
			<!-- FedUni - this example is of a  GW_Aquifer from [aquifer_properties] -->
			<!-- FedUni - xlink:href="http://groundwater.victoria.com.au/feature.aquifer/[aquifer_property.bore_id_fk].[aquifer_property.aquifer_property_id]" xlink:title="[aquifer_property.aq_name]" -->
			<gww:gwWellUnit xlink:href="http://groundwater.victoria.com.au/feature/aquifer/51409.1947" xlink:title="Newer Volcanics Formation"/>
			
<!-- ???? FedUni - Does FedUni have gww:gwWellWaterUse info? -->
			<gww:gwWellWaterUse xsi:nil="true" nilReason="unknown"/>
			<gww:gwWellYield xsi:nil="true" nilReason="unknown"/>
			<!-- gwWellLicence Licence is for relating to the drilling of the well or to the extraction of groundwater. -->
			<gww:gwWellLicence>
				<gwml2:GW_Licence>
					<!-- ???? FedUni - is gww:gwWellLicence/gwml2:gwLicenceID for borehole = [bore.bore_licence]? -->
					<gwml2:gwLicenceID>123456</gwml2:gwLicenceID>
					<!-- FedUni - gww:gwWellLicence/gwml2:gwPurpose =[bore.boretype] -->
					<gwml2:gwPurpose>General Geological Investigation</gwml2:gwPurpose>
					<!--  FedUni - does not have anything for gww:gwWellLicence/gwml2:gwTimePeriod for borehole -->
					<gwml2:gwTimePeriod xsi:nil="true"/>
				</gwml2:GW_Licence>
			</gww:gwWellLicence>
			<!-- FedUni - gwWellGeology geology logs from  [lithology.lithology_description] -->
			<!-- FedUni - gww:gwWellGeology xlink:href="http://groundwater.victoria.com.au/feature/geology-log/feduni.borehole.lithology.[lithology.bore_id_fk].[lithology:lithology_id] -->
			<gww:gwWellGeology xlink:href="http://groundwater.victoria.com.au/feature/geology-log/feduni.borehole.lithology.51409.242285"/>
				<!-- FedUni - gwWellGeology geology logs from  [stratigraphy] -->
<!-- FedUni - gww:gwWellGeology xlink:href="http://groundwater.victoria.com.au/feature/geology-log/feduni.borehole.stratigraphy.[stratigraphy.bore_id_fk]  -->
			<gww:gwWellGeology xlink:href="http://groundwater.victoria.com.au/feature/geology-log/feduni.borehole.stratigraphy.51409"/>
				<!-- FedUni - gwWellGeology age logs from  [stratigraphy] -->
